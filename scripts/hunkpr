#!/usr/bin/env bash
# hunkpr — review the current branch's PR in hunk, diffed against the PR's
# real base (merge-base of its baseRefName), so only the PR's own commits show.
set -euo pipefail

branch=$(git branch --show-current)
[[ -z "$branch" ]] && { echo "hunkpr: detached HEAD — check out a branch first" >&2; exit 1; }

remote=$(git config "branch.$branch.remote" 2>/dev/null) || remote="origin"
[[ -z "$remote" ]] && remote="origin"
url=$(git remote get-url "$remote" 2>/dev/null) || url=""
repo=$(echo "$url" | sed -E -e 's#^git@[^:]+:##' -e 's#^https?://[^/]+/##' -e 's#\.git$##')
rflag=(); [[ -n "$repo" ]] && rflag=(-R "$repo")

base=$(gh pr view --json baseRefName --jq .baseRefName "${rflag[@]}" 2>/dev/null) || base=""
if [[ -z "$base" ]]; then
  base=$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name "${rflag[@]}" 2>/dev/null) || base="main"
  echo "hunkpr: no open PR for '$branch' — diffing against $base (submit/merge unavailable)" >&2
fi

git fetch "$remote" "$base" --quiet 2>/dev/null || true
merge_base=$(git merge-base HEAD "$remote/$base" 2>/dev/null) || merge_base=$(git merge-base HEAD "$base")

exec hunk diff "$merge_base" "$@"
